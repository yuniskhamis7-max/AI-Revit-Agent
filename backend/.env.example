# ─────────────────────────────────────────────────────────────
# AI-Revit Agent — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Development toggle ───────────────────────────────────────
# When true:
#   • All tool calls are auto-approved (approval modal skipped)
#   • CORS is open to any origin (for npm run dev workflow)
#   • Logging is set to DEBUG level
#   • Revit bridge failures return empty mocks instead of errors
DEVELOPMENT_MODE=true

# ── AI Provider API Keys ─────────────────────────────────────
# Set whichever providers you intend to use. Unused keys can be left blank.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Revit Bridge ─────────────────────────────────────────────
REVIT_BRIDGE_HOST=http://127.0.0.1
REVIT_BRIDGE_PORT=8080

# ── Server ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Database ─────────────────────────────────────────────────
# Relative to backend/ directory. Created automatically on first run.
DATABASE_PATH=data/agent.db
